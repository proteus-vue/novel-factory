# 依赖与构建产物
node_modules/
dist/
dist-platform/
*.tgz

# 运行期生成的数据（含作品正文，绝不入库）
.factory-run/
.factory-data/

# 本地配置与密钥（凭证只走环境变量）
.env
.env.*
!.env.example
*.local
secrets/
*.jks
*.keystore

# 构建中间物
android/.gradle/
android/build/
android/app/build/
android/local.properties

# 签名中间产物（绝不入库）
*.idsig
release/

# 桌面安装包构建产物（体积大，走 Release 分发，不入源码仓）
release-desktop/

# 桌面交叉构建辅助工具缓存（离线下载的 appimage/fpm/nsis 等，不入仓）
.desktop-tools/

# APK：默认忽略；仅放行根目录的正式交付物
*.apk
!novel-factory-*.apk

# 验收/调试截图（根目录非交付物；品牌与资源图不受影响）
/check-*.png
/layer-*.png
/toast-*.png
/island-*.png
