{
  "name": "novel-factory",
  "version": "2.9.0",
  "description": "小说工厂：全自动创作平台（写稿 + 大禹约束 + 獬豸终审），提供 Web 控制台、Android App 与桌面工作站",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "run": "node dist/index.js run",
    "status": "node dist/index.js status",
    "export": "node dist/index.js export",
    "publish:app": "node dist/index.js publish",
    "serve": "node dist/index.js serve",
    "platform": "node dist/index.js serve",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs",
    "electron:dev": "NODE_ENV=development electron desktop/main.cjs",
    "electron:build:win": "pnpm build && electron-builder --win",
    "electron:build:linux": "pnpm build && electron-builder --linux",
    "electron:build:mac": "pnpm build && electron-builder --mac",
    "electron:build:all": "pnpm build && electron-builder --win --linux --mac -p never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "js-yaml": "^4.3.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.2",
    "@capacitor/cli": "7.4.2",
    "@capacitor/core": "7.4.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "desktopName": "novel-factory",
  "author": {
    "name": "kags",
    "email": "kags@users.noreply.github.com"
  }
}
