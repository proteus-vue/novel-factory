{
  "name": "novel-factory",
  "version": "0.1.0",
  "description": "小说工业化流水线编排层：写稿 Agent + 大禹(约束) + 獬豸(评审) + PWA Publisher",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "run": "node dist/index.js run",
    "status": "node dist/index.js status",
    "export": "node dist/index.js export",
    "publish:app": "node dist/index.js publish",
    "serve": "node dist/index.js serve",
    "platform": "node dist/index.js serve",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.2",
    "@capacitor/cli": "7.4.2",
    "@capacitor/core": "7.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.1"
  }
}
