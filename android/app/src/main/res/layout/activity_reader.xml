<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rd_day_bg"
    android:fitsSystemWindows="true">

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部工具栏 -->
        <LinearLayout
            android:id="@+id/rd_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/rd_day_bar"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:minHeight="52dp">

            <ImageButton
                android:id="@+id/rd_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@drawable/rd_ic_back"
                android:tint="@color/rd_day_text" />

            <TextView
                android:id="@+id/rd_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="阅读器"
                android:textColor="@color/rd_day_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/rd_font"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="阅读设置"
                android:src="@drawable/rd_ic_font"
                android:tint="@color/rd_day_text" />

            <ImageButton
                android:id="@+id/rd_catalog"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="目录"
                android:src="@drawable/rd_ic_list"
                android:tint="@color/rd_day_text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rd_day_line" />

        <!-- 正文滚动区 -->
        <ScrollView
            android:id="@+id/rd_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="26dp"
                android:paddingBottom="40dp">

                <TextView
                    android:id="@+id/rd_chapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rd_day_text"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="6dp" />

                <TextView
                    android:id="@+id/rd_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/rd_day_text"
                    android:textSize="17sp"
                    android:lineSpacingExtra="10dp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rd_day_line" />

        <!-- 底部栏 -->
        <LinearLayout
            android:id="@+id/rd_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/rd_day_bar"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:minHeight="48dp">

            <Button
                android:id="@+id/rd_prev"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="上一章"
                android:textSize="13sp"
                android:background="@android:color/transparent"
                android:textColor="@color/rd_day_accent" />

            <TextView
                android:id="@+id/rd_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 1"
                android:textColor="@color/rd_day_sub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/rd_next"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="下一章"
                android:textSize="13sp"
                android:background="@android:color/transparent"
                android:textColor="@color/rd_day_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- 目录抽屉（覆盖层 + 手写滑入） -->
    <View
        android:id="@+id/rd_catalog_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rd_catalog_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/rd_day_bar"
        android:translationX="300dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="目录"
            android:textColor="@color/rd_day_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="46dp"
            android:paddingBottom="16dp" />

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/rd_catalog_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 阅读设置面板（字号/主题） -->
    <LinearLayout
        android:id="@+id/rd_settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/rd_day_bar"
        android:padding="20dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="字号" android:textColor="@color/rd_day_text" android:textSize="14sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
            <Button android:id="@+id/rd_font_minus" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="44dp" android:text="A−" android:textSize="18sp"
                android:background="@android:color/transparent" android:textColor="@color/rd_day_accent"/>
            <TextView android:id="@+id/rd_font_size" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:gravity="center" android:text="17"
                android:textColor="@color/rd_day_text" android:textSize="15sp"/>
            <Button android:id="@+id/rd_font_plus" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="44dp" android:text="A＋" android:textSize="18sp"
                android:background="@android:color/transparent" android:textColor="@color/rd_day_accent"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="主题" android:textColor="@color/rd_day_text" android:textSize="14sp" android:textStyle="bold"
            android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
            <Button android:id="@+id/rd_theme_day" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="40dp" android:text="日间" android:textSize="13sp"
                android:background="@android:color/transparent" android:textColor="@color/rd_day_accent"/>
            <Button android:id="@+id/rd_theme_eye" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="40dp" android:text="护眼" android:textSize="13sp"
                android:background="@android:color/transparent" android:textColor="@color/rd_day_accent"/>
            <Button android:id="@+id/rd_theme_night" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="40dp" android:text="夜间" android:textSize="13sp"
                android:background="@android:color/transparent" android:textColor="@color/rd_day_accent"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
